{
  "schema_version": "p0-eval-1",
  "status": "contract_only",
  "description": "Implementation-neutral P0 evaluation scenarios. These are acceptance expectations, not claims about current runtime behavior.",
  "scenarios": [
    {
      "id": "plain_response",
      "purpose": "Complete a request with one model response and no tool use.",
      "request": {"message": "Reply with exactly: hello from the mock model.", "metadata": {"case": "plain_response"}},
      "mock_model": {"provider": "deterministic_mock", "script": [{"turn": 1, "when": "start", "action": {"kind": "final_text", "text": "hello from the mock model."}}]},
      "available_tools": [],
      "policy": {"default": "deny", "rules": [], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "final_text"}},
          {"type": "run.completed"}
        ],
        "final_outcome": {"status": "completed", "reason": "plain_response", "text": "hello from the mock model."},
        "evidence": {
          "required_records": [
            {"kind": "request", "assert": {"case": "plain_response"}},
            {"kind": "model_action", "assert": {"action": "final_text"}},
            {"kind": "final_outcome", "assert": {"reason": "plain_response"}}
          ],
          "invariants": ["no tool execution record exists", "no policy denial record exists"]
        }
      },
      "diagnostics": {"required_codes": [], "must_not_contain": ["authorization", "api_key"], "notes": "The ordinary completion path must remain distinguishable from tool and failure paths."}
    },
    {
      "id": "single_tool_success",
      "purpose": "Allow one deterministic tool call, return its result to the model, and complete.",
      "request": {"message": "What time is it in UTC?", "metadata": {"case": "single_tool_success"}},
      "mock_model": {"provider": "deterministic_mock", "script": [
        {"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "read_clock", "arguments": {"timezone": "UTC"}}},
        {"turn": 2, "when": {"tool_result": {"tool": "read_clock", "status": "success"}}, "action": {"kind": "final_text", "text": "09:00 UTC"}}
      ]},
      "available_tools": [{"name": "read_clock", "input_contract": {"type": "object", "required": ["timezone"], "properties": {"timezone": {"type": "string", "const": "UTC"}}}, "deterministic_result": {"status": "success", "output": {"time": "09:00", "timezone": "UTC"}}}],
      "policy": {"default": "deny", "rules": [{"tool": "read_clock", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "read_clock"}},
          {"type": "policy.evaluated", "assert": {"tool": "read_clock", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "read_clock"}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "read_clock"}},
          {"type": "model.action.emitted", "assert": {"action": "final_text"}}, {"type": "run.completed"}
        ],
        "final_outcome": {"status": "completed", "reason": "tool_success", "text": "09:00 UTC"},
        "evidence": {
          "required_records": [
            {"kind": "policy_decision", "assert": {"tool": "read_clock", "decision": "allow"}},
            {"kind": "tool_result", "assert": {"tool": "read_clock", "status": "success", "time": "09:00"}},
            {"kind": "final_outcome", "assert": {"reason": "tool_success"}}
          ],
          "invariants": ["exactly one tool execution starts", "the final response is emitted only after the successful tool result"]
        }
      },
      "diagnostics": {"required_codes": [], "must_not_contain": ["authorization", "api_key"], "notes": "The allow decision, execution, result handoff, and final response must be separately observable."}
    },
    {
      "id": "tool_denied_by_policy",
      "purpose": "Reject an available but disallowed tool call before execution.",
      "request": {"message": "Delete note N-17.", "metadata": {"case": "tool_denied_by_policy"}},
      "mock_model": {"provider": "deterministic_mock", "script": [{"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "delete_note", "arguments": {"note_id": "N-17"}}}]},
      "available_tools": [{"name": "delete_note", "input_contract": {"type": "object", "required": ["note_id"], "properties": {"note_id": {"type": "string"}}}, "deterministic_result": {"status": "success", "output": {"deleted": true}}}],
      "policy": {"default": "deny", "rules": [{"tool": "delete_note", "decision": "deny", "reason": "destructive_operation_requires_approval"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "delete_note"}},
          {"type": "policy.evaluated", "assert": {"tool": "delete_note", "decision": "deny", "reason": "destructive_operation_requires_approval"}},
          {"type": "tool.execution.blocked", "assert": {"tool": "delete_note"}},
          {"type": "diagnostic.emitted", "assert": {"code": "policy_denied"}},
          {"type": "run.terminated", "assert": {"reason": "policy_denied"}}
        ],
        "final_outcome": {"status": "terminated", "reason": "policy_denied"},
        "evidence": {
          "required_records": [
            {"kind": "policy_decision", "assert": {"tool": "delete_note", "decision": "deny"}},
            {"kind": "blocked_tool_call", "assert": {"tool": "delete_note"}},
            {"kind": "terminal_outcome", "assert": {"reason": "policy_denied"}}
          ],
          "invariants": ["no tool execution starts", "no successful completion is emitted"]
        }
      },
      "diagnostics": {"required_codes": ["policy_denied"], "must_not_contain": ["authorization", "api_key", "approval_token"], "notes": "A reviewer must distinguish policy denial from tool failure without sensitive policy or credential material."}
    },
    {
      "id": "tool_execution_failure",
      "purpose": "Allow a tool call that starts but returns a deterministic execution error.",
      "request": {"message": "Look up record R-404.", "metadata": {"case": "tool_execution_failure"}},
      "mock_model": {"provider": "deterministic_mock", "script": [{"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "lookup_record", "arguments": {"record_id": "R-404"}}}]},
      "available_tools": [{"name": "lookup_record", "input_contract": {"type": "object", "required": ["record_id"], "properties": {"record_id": {"type": "string"}}}, "deterministic_result": {"status": "error", "error": {"code": "fixture_backend_unavailable", "retryable": false}}}],
      "policy": {"default": "deny", "rules": [{"tool": "lookup_record", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "lookup_record"}},
          {"type": "policy.evaluated", "assert": {"tool": "lookup_record", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "lookup_record"}},
          {"type": "tool.execution.failed", "assert": {"tool": "lookup_record", "code": "fixture_backend_unavailable"}},
          {"type": "diagnostic.emitted", "assert": {"code": "tool_execution_failed"}},
          {"type": "run.terminated", "assert": {"reason": "tool_execution_failure"}}
        ],
        "final_outcome": {"status": "terminated", "reason": "tool_execution_failure"},
        "evidence": {
          "required_records": [
            {"kind": "policy_decision", "assert": {"tool": "lookup_record", "decision": "allow"}},
            {"kind": "tool_error", "assert": {"tool": "lookup_record", "code": "fixture_backend_unavailable"}},
            {"kind": "terminal_outcome", "assert": {"reason": "tool_execution_failure"}}
          ],
          "invariants": ["tool execution starts exactly once", "no validation failure is reported", "no successful completion is emitted"]
        }
      },
      "diagnostics": {"required_codes": ["tool_execution_failed"], "must_not_contain": ["authorization", "api_key"], "notes": "The failure must be attributable to execution after an allow decision, not policy or malformed model output."}
    },
    {
      "id": "invalid_model_action",
      "purpose": "Reject a malformed tool action before policy dispatch or tool execution.",
      "request": {"message": "Echo the value 7.", "metadata": {"case": "invalid_model_action"}},
      "mock_model": {"provider": "deterministic_mock", "script": [{"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "echo", "arguments": ["not", "an", "object"]}}]},
      "available_tools": [{"name": "echo", "input_contract": {"type": "object", "required": ["value"], "properties": {"value": {"type": "integer"}}}, "deterministic_result": {"status": "success", "output": {"value": 7}}}],
      "policy": {"default": "deny", "rules": [{"tool": "echo", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.invalid", "assert": {"action": "tool_call", "tool": "echo", "reason": "arguments_must_be_object"}},
          {"type": "diagnostic.emitted", "assert": {"code": "invalid_model_action"}},
          {"type": "run.terminated", "assert": {"reason": "invalid_model_action"}}
        ],
        "final_outcome": {"status": "terminated", "reason": "invalid_model_action"},
        "evidence": {
          "required_records": [
            {"kind": "invalid_model_action", "assert": {"tool": "echo", "reason": "arguments_must_be_object"}},
            {"kind": "terminal_outcome", "assert": {"reason": "invalid_model_action"}}
          ],
          "invariants": ["no policy evaluation occurs for the malformed action", "no tool execution starts"]
        }
      },
      "diagnostics": {"required_codes": ["invalid_model_action"], "must_not_contain": ["authorization", "api_key"], "notes": "The malformed action is a model-output contract error, not a policy denial or tool failure."}
    },
    {
      "id": "validator_failure",
      "purpose": "Receive a successful tool result that fails an explicit output validator.",
      "request": {"message": "Read profile P-7 and return the profile name.", "metadata": {"case": "validator_failure"}},
      "mock_model": {"provider": "deterministic_mock", "script": [{"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "get_profile", "arguments": {"profile_id": "P-7"}}}]},
      "available_tools": [{"name": "get_profile", "input_contract": {"type": "object", "required": ["profile_id"], "properties": {"profile_id": {"type": "string"}}}, "deterministic_result": {"status": "success", "output": {"profile_id": "P-7", "name": 17}}}],
      "policy": {"default": "deny", "rules": [{"tool": "get_profile", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [{"name": "profile_shape", "target": "tool_result", "tool": "get_profile", "contract": {"type": "object", "required": ["profile_id", "name"], "properties": {"profile_id": {"type": "string"}, "name": {"type": "string"}}}}],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "get_profile"}},
          {"type": "policy.evaluated", "assert": {"tool": "get_profile", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "get_profile"}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "get_profile"}},
          {"type": "validation.failed", "assert": {"validator": "profile_shape", "field": "name", "reason": "expected_string"}},
          {"type": "diagnostic.emitted", "assert": {"code": "validator_failed"}},
          {"type": "run.terminated", "assert": {"reason": "validation_failure"}}
        ],
        "final_outcome": {"status": "terminated", "reason": "validation_failure"},
        "evidence": {
          "required_records": [
            {"kind": "tool_result", "assert": {"tool": "get_profile", "status": "success"}},
            {"kind": "validation_failure", "assert": {"validator": "profile_shape", "field": "name"}},
            {"kind": "terminal_outcome", "assert": {"reason": "validation_failure"}}
          ],
          "invariants": ["the raw successful tool result remains inspectable", "no final response is emitted after validation failure"]
        }
      },
      "diagnostics": {"required_codes": ["validator_failed"], "must_not_contain": ["authorization", "api_key"], "notes": "Validation failure remains distinct from a tool execution error because the tool did return a result."}
    },
    {
      "id": "max_steps_exceeded",
      "purpose": "Terminate after the configured number of accepted tool steps and do not execute the next scripted action.",
      "request": {"message": "Read the counter three times.", "metadata": {"case": "max_steps_exceeded"}},
      "mock_model": {"provider": "deterministic_mock", "script": [
        {"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "read_counter", "arguments": {"slot": "A"}}},
        {"turn": 2, "when": {"tool_result": {"tool": "read_counter", "status": "success", "call_index": 1}}, "action": {"kind": "tool_call", "tool": "read_counter", "arguments": {"slot": "A"}}},
        {"turn": 3, "when": {"tool_result": {"tool": "read_counter", "status": "success", "call_index": 2}}, "action": {"kind": "tool_call", "tool": "read_counter", "arguments": {"slot": "A"}}},
        {"turn": 4, "when": {"tool_result": {"tool": "read_counter", "status": "success", "call_index": 3}}, "action": {"kind": "tool_call", "tool": "read_counter", "arguments": {"slot": "A"}}, "unreachable": true}
      ]},
      "available_tools": [{"name": "read_counter", "input_contract": {"type": "object", "required": ["slot"], "properties": {"slot": {"type": "string", "const": "A"}}}, "deterministic_result": {"status": "success", "output": {"value": 1}}}],
      "policy": {"default": "deny", "rules": [{"tool": "read_counter", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 3},
      "validators": [],
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "read_counter", "turn": 1}},
          {"type": "policy.evaluated", "assert": {"tool": "read_counter", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "read_counter"}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "read_counter", "call_index": 1}},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "turn": 2}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "read_counter", "call_index": 2}},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "turn": 3}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "read_counter", "call_index": 3}},
          {"type": "step_limit.exceeded", "assert": {"max_steps": 3}},
          {"type": "diagnostic.emitted", "assert": {"code": "max_steps_exceeded"}},
          {"type": "run.terminated", "assert": {"reason": "max_steps_exceeded"}}
        ],
        "final_outcome": {"status": "terminated", "reason": "max_steps_exceeded"},
        "evidence": {
          "required_records": [
            {"kind": "step_budget", "assert": {"max_steps": 3, "accepted_steps": 3}},
            {"kind": "terminal_outcome", "assert": {"reason": "max_steps_exceeded"}}
          ],
          "invariants": ["exactly three tool executions start", "script turn 4 is not executed", "no successful completion is emitted"]
        }
      },
      "diagnostics": {"required_codes": ["max_steps_exceeded"], "must_not_contain": ["authorization", "api_key"], "notes": "The budget boundary must be deterministic and observable without sleep or timing races."}
    },
    {
      "id": "session_replay",
      "purpose": "Resume from a recorded interruption, reuse a completed tool result, and avoid repeating a side effect.",
      "request": {"message": "Record audit event A-1 and confirm it.", "metadata": {"case": "session_replay"}},
      "mock_model": {"provider": "deterministic_mock", "script": [
        {"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "record_audit_event", "arguments": {"event_id": "A-1"}}},
        {"turn": 2, "when": {"tool_result": {"tool": "record_audit_event", "status": "success", "event_id": "A-1"}}, "action": {"kind": "final_text", "text": "recorded A-1"}}
      ]},
      "available_tools": [{"name": "record_audit_event", "input_contract": {"type": "object", "required": ["event_id"], "properties": {"event_id": {"type": "string"}}}, "deterministic_result": {"status": "success", "output": {"event_id": "A-1", "recorded": true}, "side_effect_key": "audit:A-1"}}],
      "policy": {"default": "deny", "rules": [{"tool": "record_audit_event", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "replay": {"initial_run": {"stop_after_event": "tool.execution.succeeded", "emit": "session.interrupted"}, "resume_run": {"resume_from_event": "tool.execution.succeeded", "reuse_prior_tool_result": true, "must_not_repeat_side_effect_key": "audit:A-1"}},
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "record_audit_event"}},
          {"type": "policy.evaluated", "assert": {"tool": "record_audit_event", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "record_audit_event"}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "record_audit_event", "side_effect_key": "audit:A-1"}},
          {"type": "session.interrupted"}, {"type": "session.resume_requested"},
          {"type": "session.state.restored", "assert": {"resume_from": "tool.execution.succeeded"}},
          {"type": "tool.result.reused", "assert": {"tool": "record_audit_event", "side_effect_key": "audit:A-1"}},
          {"type": "model.action.emitted", "assert": {"action": "final_text"}}, {"type": "run.completed"}
        ],
        "final_outcome": {"status": "completed", "reason": "replay_consistent", "text": "recorded A-1"},
        "evidence": {
          "required_records": [
            {"kind": "session_checkpoint", "assert": {"after": "tool.execution.succeeded"}},
            {"kind": "reused_tool_result", "assert": {"tool": "record_audit_event"}},
            {"kind": "side_effect_count", "assert": {"side_effect_key": "audit:A-1", "count": 1}},
            {"kind": "final_outcome", "assert": {"reason": "replay_consistent"}}
          ],
          "invariants": ["the initial tool side effect occurs exactly once across both runs", "the resumed run does not emit a second tool.execution.started event", "the resumed model action is the scripted final response"]
        }
      },
      "diagnostics": {"required_codes": ["session_interrupted", "session_resumed"], "must_not_contain": ["authorization", "api_key"], "notes": "Replay correctness is about durable logical state and duplicate-side-effect prevention, not wall-clock timing."}
    },
    {
      "id": "deterministic_repeated_run",
      "purpose": "Run the same fixture twice from fresh state and compare normalized event, outcome, and Evidence results.",
      "request": {"message": "Add 2 and 3, then reply with the sum.", "metadata": {"case": "deterministic_repeated_run"}},
      "mock_model": {"provider": "deterministic_mock", "script": [
        {"turn": 1, "when": "start", "action": {"kind": "tool_call", "tool": "add_numbers", "arguments": {"left": 2, "right": 3}}},
        {"turn": 2, "when": {"tool_result": {"tool": "add_numbers", "status": "success"}}, "action": {"kind": "final_text", "text": "5"}}
      ]},
      "available_tools": [{"name": "add_numbers", "input_contract": {"type": "object", "required": ["left", "right"], "properties": {"left": {"type": "integer"}, "right": {"type": "integer"}}}, "deterministic_result": {"status": "success", "output": {"sum": 5}}}],
      "policy": {"default": "deny", "rules": [{"tool": "add_numbers", "decision": "allow"}], "on_denied": "terminate"},
      "limits": {"max_steps": 4},
      "validators": [],
      "repeatability": {"runs": 2, "compare": ["normalized_event_sequence", "final_outcome", "evidence"], "ignore_fields": ["run_id", "event_id", "started_at", "finished_at"]},
      "expected": {
        "event_sequence": [
          {"type": "run.started"}, {"type": "request.accepted"},
          {"type": "model.action.emitted", "assert": {"action": "tool_call", "tool": "add_numbers"}},
          {"type": "policy.evaluated", "assert": {"tool": "add_numbers", "decision": "allow"}},
          {"type": "tool.execution.started", "assert": {"tool": "add_numbers"}},
          {"type": "tool.execution.succeeded", "assert": {"tool": "add_numbers", "sum": 5}},
          {"type": "model.action.emitted", "assert": {"action": "final_text", "text": "5"}}, {"type": "run.completed"}
        ],
        "final_outcome": {"status": "completed", "reason": "deterministic", "text": "5"},
        "evidence": {
          "required_records": [
            {"kind": "repeatability_check", "assert": {"runs": 2, "normalized_equal": true}},
            {"kind": "tool_result", "assert": {"tool": "add_numbers", "sum": 5}},
            {"kind": "final_outcome", "assert": {"reason": "deterministic"}}
          ],
          "invariants": ["both fresh runs have the same normalized logical event sequence", "both fresh runs have equal final outcomes", "both fresh runs have equal Evidence after the listed fields are ignored"]
        }
      },
      "diagnostics": {"required_codes": [], "must_not_contain": ["authorization", "api_key", "nondeterministic"], "notes": "Only run-specific identity and timing fields may differ between the two fresh runs."}
    }
  ]
}
